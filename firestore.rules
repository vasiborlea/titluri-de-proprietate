rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function userEmail() {
      return request.auth.token.email.lower();
    }

    // Administratorul principal: hardcodat, nu poate fi retrogradat sau eliminat din aplicație.
    function isOwner() {
      return verified() && userEmail() == 'borleavasi@gmail.com';
    }

    // Conturi adăugate din Setări: un document per e-mail în allowedUsers/{email}, cu:
    //   role = 'admin' | 'user'
    //   apps = { titluri: bool, distante: bool }   (dacă lipsește, contul are acces la ambele)
    function isMember() {
      return verified()
        && exists(/databases/$(database)/documents/allowedUsers/$(userEmail()));
    }
    function memberData() {
      return get(/databases/$(database)/documents/allowedUsers/$(userEmail())).data;
    }

    // Administrator = administratorul principal sau un cont din listă cu role == 'admin'.
    function isAdmin() {
      return isOwner() || (isMember() && memberData().get('role', 'user') == 'admin');
    }

    // Acces la o aplicație: administratorii au acces la tot; ceilalți doar la aplicațiile bifate.
    function hasApp(name) {
      return isAdmin()
        || (isMember()
            && memberData().get('apps', {'titluri': true, 'distante': true}).get(name, false) == true);
    }

    // Titlurile și scanurile: doar conturile cu acces la aplicația „Titluri”.
    match /titles/{id} {
      allow read, write: if hasApp('titluri');
    }
    match /scans/{id} {
      allow read, write: if hasApp('titluri');
    }

    // Lista conturilor: administratorii o citesc și o modifică;
    // fiecare cont își poate citi doar propriul document (ca paginile să-i afle rolul și permisiunile).
    match /allowedUsers/{email} {
      allow get: if isAdmin() || (verified() && email == userEmail());
      allow list, create, update, delete: if isAdmin();
    }

    // Marcaje interne.
    match /meta/{id} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
