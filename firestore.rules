rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function userEmail() {
      return request.auth.token.email.lower();
    }

    // Administratorul principal: hardcodat, nu poate fi retrogradat sau eliminat din aplicație.
    function isOwner() {
      return verified() && userEmail() == 'borleavasi@gmail.com';
    }

    // Conturi adăugate din Setări: un document per e-mail în allowedUsers/{email}, cu câmpul role = 'admin' | 'user'.
    function isMember() {
      return verified()
        && exists(/databases/$(database)/documents/allowedUsers/$(userEmail()));
    }

    // Administrator = administratorul principal sau un cont din listă cu role == 'admin'.
    function isAdmin() {
      return isOwner()
        || (isMember()
            && get(/databases/$(database)/documents/allowedUsers/$(userEmail())).data.get('role', 'user') == 'admin');
    }

    // Acces la date (titluri și scanuri): administratorul principal + orice cont din listă (admin sau user).
    function allowed() {
      return isOwner() || isMember();
    }

    match /titles/{id} {
      allow read, write: if allowed();
    }

    // Scanurile (imagini JPEG comprimate), tot doar pentru conturile cu acces.
    match /scans/{id} {
      allow read, write: if allowed();
    }

    // Lista conturilor cu acces: administratorii o citesc și o modifică;
    // fiecare cont își poate citi doar propriul document (ca aplicația să-i afle rolul).
    match /allowedUsers/{email} {
      allow get: if isAdmin() || (verified() && email == userEmail());
      allow list, create, update, delete: if isAdmin();
    }

    // Marcaje interne (ex. migrarea inițială a conturilor existente).
    match /meta/{id} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
